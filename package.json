{
  "name": "@corvus-dsh/dsh-memory",
  "version": "2.2.0",
  "description": "星火 OS 记忆层 (memory): capability memory for long sessions. Consumes the handoff ledger, extracts four cognitive layers (facts with seq pointers, experiences, negative paths, structured SKILL.md skills) from finished sessions, filters retrieval with a cheap LLM relevance pass, and never imports the slicing plugin. Supports hybrid lexical+semantic recall and an optional node:sqlite inverted index.",
  "private": false,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": "./lib/index.js",
    "./retrieve": "./lib/retrieve.js",
    "./store": "./lib/store.js",
    "./client": "./client.js",
    "./manifest": "./manifest.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "src",
    "client.js",
    "manifest.json",
    "cordis.patch.yml",
    "scripts",
    "README.md",
    "LICENSE",
    "ARCHITECTURE.md",
    "RELEASE_NOTES.md",
    "icon.svg",
    "locale"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "harvest": "node scripts/harvest.mjs",
    "prepare": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=22.5.0",
    "dsh": ">=0.2.1-rc.5"
  },
  "peerDependencies": {
    "@corvus-dsh/dsh-paradise": "*"
  },
  "peerDependenciesMeta": {
    "@corvus-dsh/dsh-paradise": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "skills",
    "agent-memory",
    "harness",
    "hybrid-search",
    "sqlite-index",
    "starfire"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corvus-dsh/dsh-memory.git"
  },
  "homepage": "https://github.com/corvus-dsh/dsh-memory#readme",
  "bugs": {
    "url": "https://github.com/corvus-dsh/dsh-memory/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
