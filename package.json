{
  "name": "dsh-memory",
  "version": "0.1.0",
  "description": "DSH open-source ecosystem plugin (topic: dsh-plugin): capability memory for long sessions. Consumes the handoff ledger, extracts reusable skills (SKILL.md) and negative paths (negatives.jsonl) from finished sessions, and never imports the slicing plugin.",
  "private": false,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": "./lib/index.js",
    "./manifest": "./manifest.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "src",
    "manifest.json",
    "cordis.patch.yml",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "harvest": "node scripts/harvest.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "skills",
    "agent-memory",
    "harness"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corvus-dsh/dsh-memory.git"
  },
  "homepage": "https://github.com/corvus-dsh/dsh-memory#readme",
  "bugs": {
    "url": "https://github.com/corvus-dsh/dsh-memory/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}